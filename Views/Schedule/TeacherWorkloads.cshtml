@model List<SchoolSchedule.Models.ViewModels.TeacherWorkloadViewModel>

@{
    ViewData["Title"] = "إحصائيات المعلمين";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-chart-bar"></i> إحصائيات المعلمين وتوزيع الحصص
        </div>
        <span class="badge bg-light text-dark">@ViewBag.AcademicYear - الفصل @ViewBag.Semester</span>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-primary text-white text-center">
                    <div class="card-body">
                        <h3>@Model.Count</h3>
                        <p class="mb-0">إجمالي المعلمين</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-success text-white text-center">
                    <div class="card-body">
                        <h3>@Model.Sum(t => t.TotalPeriods)</h3>
                        <p class="mb-0">إجمالي الحصص</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-info text-white text-center">
                    <div class="card-body">
                        <h3>@(Model.Any() ? Math.Round(Model.Average(t => t.TotalPeriods), 1) : 0)</h3>
                        <p class="mb-0">متوسط الحصص للمعلم</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>اسم المعلم</th>
                        <th>المادة</th>
                        <th class="text-center">عدد الحصص</th>
                        <th class="text-center">عدد الصفوف</th>
                        <th class="text-center">المنصب</th>
                        <th class="text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var teacher in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td>
                                <i class="fas fa-user-tie text-primary"></i>
                                @teacher.TeacherName
                            </td>
                            <td>@teacher.SubjectName</td>
                            <td class="text-center">
                                <span class="badge bg-success">@teacher.TotalPeriods</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info">@teacher.NumberOfClasses</span>
                            </td>
                            <td class="text-center">
                                @if (teacher.IsHeadOfDepartment)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-star"></i> رئيس قسم
                                    </span>
                                }
                                @if (teacher.IsSupervisor)
                                {
                                    <span class="badge bg-primary">
                                        <i class="fas fa-shield-alt"></i> مشرف
                                    </span>
                                }
                                @if (!teacher.IsHeadOfDepartment && !teacher.IsSupervisor)
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("TeacherSchedule", new { id = teacher.TeacherId })" 
                                   class="btn btn-sm btn-primary">
                                    <i class="fas fa-calendar"></i> الجدول
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="3"><strong>الإجمالي</strong></td>
                        <td class="text-center">
                            <strong class="text-success">@Model.Sum(t => t.TotalPeriods)</strong>
                        </td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="card mt-3">
        <div class="card-header">
            <i class="fas fa-chart-pie"></i> توزيع الحصص حسب المادة
        </div>
        <div class="card-body">
            <div class="row">
                @{
                    var subjectGroups = Model.GroupBy(t => t.SubjectName);
                }
                @foreach (var group in subjectGroups)
                {
                    <div class="col-md-3 mb-3">
                        <div class="card border-primary">
                            <div class="card-body text-center">
                                <h6 class="text-primary">@group.Key</h6>
                                <h4 class="text-success">@group.Sum(t => t.TotalPeriods)</h4>
                                <small class="text-muted">
                                    @group.Count() معلم/ة
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning text-center mt-3">
        <i class="fas fa-exclamation-triangle"></i>
        لا توجد بيانات لعرضها. قم باستيراد البيانات أو إضافة حصص جديدة.
    </div>
}
