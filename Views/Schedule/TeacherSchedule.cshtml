@model SchoolSchedule.Models.ViewModels.TeacherScheduleViewModel

@{
    ViewData["Title"] = $"جدول {Model.TeacherName}";
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-user-tie"></i>
            <strong>جدول المعلم:</strong> @Model.TeacherName
        </div>
        <div>
            <a asp-action="PrintTeacherSchedule" asp-route-id="@Model.TeacherId" 
               class="btn btn-success btn-sm" target="_blank">
                <i class="fas fa-print"></i> طباعة
            </a>
            <a asp-action="TeacherList" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> عودة
            </a>
        </div>
    </div>
    <div class="card-body">
        <!-- معلومات المعلم -->
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <i class="fas fa-book fa-2x text-success mb-2"></i>
                        <h6 class="text-muted">المادة</h6>
                        <h5 class="text-success">@Model.SubjectName</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <i class="fas fa-calendar-check fa-2x text-info mb-2"></i>
                        <h6 class="text-muted">عدد الحصص</h6>
                        <h5 class="text-info">@Model.TotalPeriods</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <i class="fas fa-users fa-2x text-primary mb-2"></i>
                        <h6 class="text-muted">عدد الصفوف</h6>
                        <h5 class="text-primary">@Model.NumberOfClasses</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <i class="fas fa-graduation-cap fa-2x text-warning mb-2"></i>
                        <h6 class="text-muted">المنصب</h6>
                        <div>
                            @if (Model.IsHeadOfDepartment)
                            {
                                <span class="badge bg-warning text-dark">رئيس قسم</span>
                            }
                            @if (Model.IsSupervisor)
                            {
                                <span class="badge bg-primary">مشرف</span>
                            }
                            @if (!Model.IsHeadOfDepartment && !Model.IsSupervisor)
                            {
                                <span class="text-muted">معلم</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- الصفوف التي يدرسها -->
        @if (Model.Classes.Any())
        {
            <div class="alert alert-info">
                <strong><i class="fas fa-chalkboard"></i> الصفوف التي يدرسها:</strong>
                <div class="mt-2">
                    @foreach (var className in Model.Classes)
                    {
                        <span class="badge bg-success me-1">@className</span>
                    }
                </div>
            </div>
        }

        <!-- معلومات العام الدراسي -->
        <div class="alert alert-light d-flex justify-content-between align-items-center">
            <div>
                <strong>العام الدراسي:</strong> @Model.AcademicYear
            </div>
            <div>
                <strong>الفصل الدراسي:</strong> @(Model.Semester == 1 ? "الأول" : "الثاني")
            </div>
        </div>
    </div>
</div>

<!-- جدول الحصص -->
<div class="card">
    <div class="card-header bg-success text-white">
        <i class="fas fa-table"></i> جدول الحصص الأسبوعي
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0" style="min-width: 800px;">
                <thead class="table-success">
                    <tr>
                        <th style="width: 100px;" class="text-center">الحصة / اليوم</th>
                        @foreach (var day in Model.DayNames)
                        {
                            <th class="text-center">@day</th>
                        }
                    </tr>
                    <tr class="table-light">
                        <th class="text-center"><small>الوقت</small></th>
                        @foreach (var time in Model.PeriodTimes)
                        {
                            <th class="text-center"><small>@time</small></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int periodIndex = 0; periodIndex < Model.PeriodNumbers.Count; periodIndex++)
                    {
                        <tr>
                            <td class="text-center table-success">
                                <strong>الحصة @Model.PeriodNumbers[periodIndex]</strong>
                            </td>
                            @for (int dayIndex = 0; dayIndex < Model.DayNames.Count; dayIndex++)
                            {
                                var schedule = Model.ScheduleGridList[dayIndex][periodIndex];
                                if (schedule != null && !schedule.IsEmpty)
                                {
                                    <td class="text-center align-middle" style="background-color: #fff3cd;">
                                        <div>
                                            <strong class="text-success d-block">@schedule.ClassName</strong>
                                            <small class="text-muted">@schedule.SubjectName</small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(schedule.Notes))
                                        {
                                            <div class="mt-1">
                                                <span class="badge bg-info" style="font-size: 10px;">@schedule.Notes</span>
                                            </div>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td class="text-center align-middle" style="background-color: #f8f9fa;">
                                        <span class="text-muted">فراغ</span>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ملاحظات -->
<div class="card mt-3">
    <div class="card-body">
        <h6><i class="fas fa-info-circle text-info"></i> ملاحظات:</h6>
        <ul class="mb-0">
            <li>الحصص باللون <span class="badge bg-warning text-dark">الأصفر</span> هي حصص المعلم</li>
            <li>الخلايا الرمادية تمثل فراغات في الجدول</li>
            <li>يمكن طباعة الجدول من الزر أعلى الصفحة</li>
        </ul>
    </div>
</div>

@section Scripts {
    <style>
        /* تنسيق إضافي للطباعة */
        @@media print {
            .btn, .alert, .card-header .btn-group {
                display: none !important;
            }
        }
    </style>
}
