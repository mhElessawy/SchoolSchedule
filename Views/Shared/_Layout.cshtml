<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الجدول المدرسي</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
        }

        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            box-shadow: 0 2px 4px rgba(0,0,0,.1);
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.3rem;
        }

        .main-content {
            padding: 20px 0;
            min-height: calc(100vh - 180px);
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            margin-bottom: 20px;
        }

        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 10px 10px 0 0 !important;
            padding: 15px 20px;
            font-weight: bold;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }

        .schedule-table th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 8px;
            text-align: center;
            font-weight: bold;
            border: 1px solid #dee2e6;
        }

        .schedule-table td {
            padding: 10px 8px;
            text-align: center;
            border: 1px solid #dee2e6;
            vertical-align: middle;
            min-height: 60px;
        }

        .schedule-table td.period-header {
            background: #f8f9fa;
            font-weight: bold;
            width: 60px;
        }

        .schedule-cell {
            background: #ffffff;
            border-radius: 4px;
            padding: 8px;
            min-height: 55px;
            position: relative;
            transition: all 0.3s;
        }

        .schedule-cell:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,.15);
        }

        .schedule-cell.has-class {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            border-right: 4px solid #2196F3;
        }

        .schedule-cell.empty-cell {
            background: #f8f9fa;
            cursor: pointer;
        }

        .schedule-cell.empty-cell:hover {
            background: #e9ecef;
        }

        .subject-name {
            font-weight: bold;
            color: #1976D2;
            font-size: 0.95rem;
            display: block;
            margin-bottom: 3px;
        }

        .teacher-name {
            color: #666;
            font-size: 0.85rem;
            display: block;
        }

        .class-name {
            color: #1976D2;
            font-weight: bold;
            font-size: 0.95rem;
        }

        .btn-action {
            padding: 2px 8px;
            font-size: 0.75rem;
            margin: 2px;
        }

        .footer {
            background: #343a40;
            color: white;
            padding: 15px 0;
            margin-top: 30px;
        }

        .alert {
            border-radius: 8px;
            border: none;
        }

      
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark no-print">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Schedule")">
                <i class="fas fa-calendar-alt"></i> نظام الجدول المدرسي
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Schedule")">
                            <i class="fas fa-home"></i> الرئيسية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ClassList", "Schedule")">
                            <i class="fas fa-chalkboard"></i> الصفوف
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("TeacherList", "Schedule")">
                            <i class="fas fa-chalkboard-teacher"></i> المعلمين
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("TeacherWorkloads", "Schedule")">
                            <i class="fas fa-chart-bar"></i> الإحصائيات
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="importDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-file-excel"></i> Excel
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@Url.Action("Import", "Import")">استيراد</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Export", "Import")">تصدير</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Search", "Schedule")">
                            <i class="fas fa-search"></i> بحث
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Warnings"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle"></i> @Html.Raw(TempData["Warnings"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="footer no-print">
        <div class="container text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year نظام الجدول المدرسي - جميع الحقوق محفوظة
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
